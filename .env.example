APP_ENV=development
STRUCTURED_LOGGING=true
LOG_LEVEL=INFO
# Comma-separated browser origins. Required in production and must be HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production login-abuse protection. Redis-backed distributed limiting is needed before API horizontal scaling.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# External address students use after deployment, such as https://ai.example.com.
PUBLIC_APP_BASE_URL=http://localhost
# Use your verified domain in production, such as ai.example.com, for Caddy automatic HTTPS.
CADDY_SITE_ADDRESS=http://localhost
PLATFORM_DB_PATH=var/platform.db
# Keep `sqlite` for the present single-server deployment. PostgreSQL migration is enabled only after all repository adapters are migrated.
PLATFORM_STORAGE_MODE=sqlite
DATABASE_URL=
COURSE_STORAGE_PATH=var/course-materials
GENERATED_ASSET_STORAGE_PATH=var/generated-assets
WORK_ARTIFACT_STORAGE_PATH=var/work-artifacts
WORK_INTERACTION_STORAGE_PATH=var/work-interactions
DEPLOYMENT_STORAGE_PATH=var/deployments
LEARNING_STORAGE_PATH=var/learning
PUBLIC_API_BASE_URL=http://localhost:8000
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=
# SQLite remains the production database for the single-server deployment.
# 腾讯云 COS 可选。设置完整配置后，新生成的图片、音频和视频自动复制到 COS。
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_PUBLIC_BASE_URL=
TENCENT_COS_PREFIX=generated-assets
TENCENT_COS_COURSE_PREFIX=course-materials
# Redis 仅用于多实例部署时的队列/会话扩展；单机 SQLite 方案不需要配置。
REDIS_URL=
POSTGRES_DB=xiao_edu
POSTGRES_USER=xiao_edu
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 上传文件病毒扫描。不配置时使用本地启发式扫描兜底；配置后接入 ClamAV daemon。
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
# Media worker recovery and throughput controls.
MEDIA_WORKER_INTERVAL_SECONDS=3
MEDIA_WORKER_MAX_ATTEMPTS=3
MEDIA_WORKER_TASK_TIMEOUT_SECONDS=900
MEDIA_WORKER_MAX_CONCURRENCY=1

# Optional AgentScope runtime. The factory accepts an agent id and returns an AgentScope agent.
# Do not put model keys or MCP credentials in these values.
AGENTSCOPE_AGENT_FACTORY=
# Example: AGENTSCOPE_AGENT_FACTORY=infra.agentscope_factory:create_agent
# JSON names only, e.g. ["school-knowledge", "approved-image-search"]
AGENTSCOPE_MCP_SERVERS=[]
# Deployment-only MCP endpoints. Do not expose this setting to the admin UI.
# Example HTTP: [{"id":"school-knowledge","transport":"http","url":"https://mcp.example.com/rpc"}]
# Example stdio: [{"id":"local-library","transport":"stdio","command":"node","args":["/opt/mcp/library.js"]}]
MCP_SERVER_CONNECTIONS=[]

# Keep provider keys only in your untracked local .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ID=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_TEXT_MODEL_ID=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
